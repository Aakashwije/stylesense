# Shared backend environment template.
# Copy to .env and override values per environment.

# --- Postgres ---
POSTGRES_USER=stylesense
POSTGRES_PASSWORD=stylesense_dev
POSTGRES_DB=stylesense
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT (shared across services that verify tokens) ---
JWT_SECRET=replace_me_with_a_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- gateway (frontend's primary entry point) ---
GATEWAY_PORT=8000

# --- core-api ---
CORE_API_PORT=4000
CORE_API_LOG_LEVEL=info

# --- ai-service ---
AI_SERVICE_PORT=8001
AI_SERVICE_LOG_LEVEL=info
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- realtime-service ---
REALTIME_SERVICE_PORT=5001
REALTIME_SERVICE_LOG_LEVEL=info
